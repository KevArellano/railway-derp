# Local development environment variables.
# Copy to `.env` and adjust. Railway sets PORT automatically in production.

# Port the server listens on locally (Railway overrides this).
PORT=3000

# Log verbosity: trace | debug | info | warn | error
RUST_LOG=info,tower_http=info

# Postgres connection string. Required — the app exits at startup if unset.
# On Railway, attach a Postgres service and set this to the reference
# ${{Postgres.DATABASE_URL}} so it resolves over the private network.
# For local dev, point at a local Postgres, e.g. via Docker:
#   docker run --rm -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:17
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# Session cookie Secure flag. Defaults to true (HTTPS-only), which is correct
# on Railway. Set to false for local development over plain HTTP, otherwise the
# browser refuses to store the session cookie and login/signup won't persist.
COOKIE_SECURE=false
